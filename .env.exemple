# Reglages de docker-compose. Copier ce fichier en « .env » a cote, et ajuster.
# Rien a modifier dans docker-compose.yml.

# ── Mot de passe du premier compte ──────────────────────────────────────
# Le studio cree un compte « admin » au premier demarrage. Sans cette ligne, son
# mot de passe est tire au sort et affiche UNE fois au demarrage :
#
#   docker compose logs comfystudio | grep -A3 "Compte administrateur"
#
# LIGNE COMMENTEE A DESSEIN. Elle etait active, avec sa valeur d'exemple : un
# « cp .env.exemple .env » suivi d'un demarrage posait donc un mot de passe
# PUBLIE DANS LE DEPOT sur un port ouvert a tout le reseau. Ne la decommente que
# pour y mettre le tien.
#STUDIO_ADMIN_MDP=change-moi-avant-le-premier-demarrage

# ── Nom du projet Compose ───────────────────────────────────────────────
# C'est lui qui decide du volume et du conteneur, PAS le nom des services. Deux
# clones nommes « comfystudio » partagent donc le meme volume : un « docker
# compose down -v » dans le second efface les conversations, les comptes et les
# cles du premier. Le changer est la SEULE facon de faire cohabiter deux studios
# sur une machine.
#COMPOSE_PROJECT_NAME=comfystudio

# ── Ports publies sur l'hote ────────────────────────────────────────────
STUDIO_PORT=8199
COMFY_PORT=8188
OLLAMA_PORT=11434

# ── Ou trouver ComfyUI et Ollama ────────────────────────────────────────
# Par defaut : sur la machine hote, hors conteneur.
# AVEC « --profile complet » ou « --profile moteur », ils tournent dans des
# conteneurs voisins : decommenter alors ces deux lignes. Compose ne sait pas
# changer ces adresses tout seul selon le profil.
# COMFY_URL=http://comfyui:8188
# OLLAMA_URL=http://ollama:11434

# OLLAMA_URL accepte PLUSIEURS adresses separees par des virgules. Le studio
# parle a chacune en direct et choisit : jamais une machine en pause, une carte
# libre avant une carte occupee, la plus petite a egalite — sauf pour lire une
# image, ou c'est la plus grosse. Une seule adresse obligeait a choisir une fois
# pour toutes la machine qui pense, et c'est justement la plus grosse qu'on met
# en pause pour jouer.
# OLLAMA_URL=http://192.168.1.42:11434,http://192.168.1.191:11434

# ── Carte graphique du conteneur ComfyUI ────────────────────────────────
# cu128  RTX 20xx et plus recentes
# cu126  GTX 10xx et TITAN X (Pascal) — cu128 ne contient PAS leurs noyaux et
#        rend « no kernel image is available for execution on the device »
# cpu    sans carte : demarre et repond, mais genere tres lentement
ROUE=cu128

# Arguments supplementaires pour ComfyUI. Sur une petite carte :
# --lowvram sous 8 Go, --novram sous 4 Go.
COMFY_ARGS=

# ── Modeles de langage ──────────────────────────────────────────────────
STUDIO_LLM=qwen2.5vl:7b
STUDIO_VISION=qwen2.5vl:7b
# Vide : le studio choisit tout seul le plus gros modele installe qui tienne
# en memoire, et ne s'en sert que pour ecrire (paroles, textes).
STUDIO_LLM_ECRITURE=

# ── Machines en pause, et nuage : CA SE REGLE DANS /admin ───────────────
# Trois reglages se posent dans /admin plutot qu'ici :
#
#   STUDIO_PAUSE_PROPOSE  minutes pendant lesquelles une demande qui reclame une
#                         carte EN PAUSE patiente devant l'ecran (30)
#   STUDIO_ARMEE_HEURES   heures pendant lesquelles elle reste ensuite ARMEE et
#                         repart toute seule au reveil de la machine (12). A
#                         zero, on retrouve le refus immediat d'avant
#   STUDIO_PLAFOND_NUAGE  appels distants qu'un compte peut faire dans le MOIS
#                         avant de revenir au local (0 = aucune limite)
#
# Ces trois-la arrivent bien jusqu'au conteneur, mais ils ne donnent que la
# valeur du PREMIER demarrage : ensuite c'est /admin qui fait foi, et la valeur
# posee la-bas survit aux redemarrages. Les decommenter n'a donc d'effet que sur
# une installation neuve — sous le tableau des machines pour les deux premiers,
# dans l'onglet du cout du nuage pour le troisieme.
#STUDIO_PAUSE_PROPOSE=30
#STUDIO_ARMEE_HEURES=12
#STUDIO_PLAFOND_NUAGE=0

# ── Connexion ───────────────────────────────────────────────────────────
# « obligatoire » (defaut) ou « libre ». Ne mettre « libre » qu'en sachant que
# quiconque atteint le port peut alors tout faire, cles d'API comprises.
STUDIO_AUTH=obligatoire

# Nom du conteneur et tag de l'image. A changer seulement si l'on veut faire
# tourner DEUX studios sur la meme machine — un essai a cote d'une installation
# en service, par exemple. « docker compose -p autre » ne suffit pas : le nom du
# conteneur et le tag ne dependent pas du projet, et un « --build » retaguerait
# l'image de l'autre.
#STUDIO_NOM=comfystudio
#STUDIO_IMAGE=comfystudio:latest
#COMFY_NOM=comfyui
#COMFY_IMAGE=comfystudio-comfyui:latest
#OLLAMA_NOM=ollama
