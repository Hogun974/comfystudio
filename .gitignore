# Donnees personnelles : les conversations contiennent les demandes de
# l'utilisateur et les chemins de ses images. Rien de tout cela ne doit partir
# dans un depot public.
conversations/
utilisateurs/

# Python
__pycache__/
*.pyc

# Reglages locaux (chemins machine, port, modeles choisis)
.env
config.local.json
# adresses des machines du reseau : noeuds.exemple.json suffit au depot
noeuds.json

# Sorties de test
sorties/
*.log
sorties/
agent_noeud.json

# Retours des utilisateurs : contiennent leurs demandes
avis.jsonl

# Appels distants consignes : noms de comptes et rythme d'usage de chacun
nuage.jsonl

# Sauvegardes de conversations : elles contiennent les demandes de
# l'utilisateur ET les fichiers _cles.json / _admin.json / _noeuds.json.
# Une seule s'est retrouvee dans un commit, avec de vraies cles d'API dedans.
conversations_sauvegarde*/
*_sauvegarde*/
studio.err

# Paquet Windows : build/ et dist/ contiennent un executable de 45 Mo
paquet/build/
paquet/dist/

# Secret des sessions : il vit dans conversations/, deja exclu


# Le modele d'aiguillage entraine avec les demandes reelles de CETTE
# installation. Un modele bayesien ne garde pas les phrases, mais il garde
# les mots et leurs comptes : c'est peu, et deja trop pour un depot public.
# Le modele du depot, aiguilleur.json, ne contient que le corpus.
aiguilleur.local.json
# Les comptes rendus de relecture de securite decrivent, par construction, ou
# le studio est faible et a quoi ressemble le reseau sur lequel il tourne. Ils
# restent sur le disque de qui les a demandes ; ils ne partent pas en public.
essai_securite*.md
essai_installation2.md
essai_chaine_complete.md
essai_apparence.md
essai_cible_absente.md
etude_parallelisme.md
essai_annulation_chaine.md
essai_modeles_ecriture.md
banc_ecriture/resultats.jsonl
